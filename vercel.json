{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/expire-deposit-appointments",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/process-payment-notifications",
      "schedule": "2-59/5 * * * *"
    }
  ]
}